# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT Authentication
# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your-secret-key-here

# Sentry Error Monitoring (optional)
SENTRY_DSN=https://your-dsn@sentry.io/project-id
ENVIRONMENT=production

# Render Deployment
RENDER_EXTERNAL_URL=https://your-app.onrender.com

# Chatbot (optional)
CHATBOT_USE_LLM=false
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo

# Environment
ENV=production

# CORS (optional - comma separated list of allowed origins)
# ALLOWED_ORIGINS=https://grumpy-gamer.vercel.app,https://staging.grumpy-gamer.vercel.app

# Stripe (coin purchases). The webhook refuses all events unless the secret is set.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Coin economy and fraud protection (defaults shown)
# COIN_MIN_SECONDS_BETWEEN_REWARDS=15
# COIN_DAILY_EARN_CAP=150
# COIN_IP_DAILY_EARN_CAP=400
# Proxies in front of the app that append to X-Forwarded-For (Render: 1)
# TRUSTED_PROXY_HOPS=1
# Comma-separated emails allowed to view coin alerts and the audit log
# ADMIN_EMAILS=you@example.com
